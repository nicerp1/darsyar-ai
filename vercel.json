{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?:index\\.html|landing(?:/index\\.html|/)?)$",
      "has": [{ "type": "host", "value": "^(?:www\\.)?ravandstudy\\.ir$" }],
      "status": 308,
      "headers": { "Location": "https://ravandstudy.ir/" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "^(?:www\\.)?ravandstudy\\.ir$" }],
      "dest": "/landing/index.html"
    },
    {
      "src": "^/(?:study-planner(?:/|\\.html)|landing/study-planner\\.html)$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "status": 308,
      "headers": { "Location": "https://ravandstudy.ir/study-planner" }
    },
    {
      "src": "^/(?:pomodoro-study-room(?:/|\\.html)|landing/pomodoro-study-room\\.html)$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "status": 308,
      "headers": { "Location": "https://ravandstudy.ir/pomodoro-study-room" }
    },
    {
      "src": "^/(?:advisors(?:/|\\.html)|landing/advisors\\.html)$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "status": 308,
      "headers": { "Location": "https://ravandstudy.ir/advisors" }
    },
    {
      "src": "^/(study-planner|advisors|pomodoro-study-room|akhbar-motaleie|atamghar-motaleie|flashcard-laytnr|pomodoro|program-rez-konkur)/?$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "dest": "/landing/$1.html"
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml|googlef6a6bb91e5999d54\\.html)$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "dest": "/landing/$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [{ "type": "host", "value": "^darsyar-ai\\.vercel\\.app$" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml)$",
      "has": [{ "type": "host", "value": "^app\\.ravandstudy\\.ir$" }],
      "dest": "/seo/app/$1"
    },
    { "handle": "filesystem" }
  ]
}
