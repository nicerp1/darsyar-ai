{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?:index\\.html|landing(?:/index\\.html|/)?)$",
      "has": [{ "type": "host", "value": "^(?:www\\.)?ravandstudy\\.ir$" }],
      "status": 308,
      "headers": { "Location": "https://ravandstudy.ir/" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "^(?:www\\.)?ravandstudy\\.ir$" }],
      "dest": "/landing/index.html"
    },
    {
      "src": "^/(?:study-planner(?:/|\\.html)|landing/study-planner\\.html)$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "status": 308,
      "headers": { "Location": "https://ravandstudy.ir/study-planner" }
    },
    {
      "src": "^/study-planner$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "dest": "/landing/study-planner.html"
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml|googlef6a6bb91e5999d54\\.html)$",
      "has": [{ "type": "host", "value": "^ravandstudy\\.ir$" }],
      "dest": "/landing/$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "has": [{ "type": "host", "value": "^darsyar-ai\\.vercel\\.app$" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml)$",
      "has": [{ "type": "host", "value": "^app\\.ravandstudy\\.ir$" }],
      "dest": "/seo/app/$1"
    },
    { "handle": "filesystem" }
  ]
}
